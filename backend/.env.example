# Render injects DATABASE_URL from the attached Postgres
DATABASE_URL=sqlite:///./folio.db

# dev = bearer token is the user id (local only!)  |  clerk = verify Clerk JWTs
AUTH_MODE=dev
CLERK_JWKS_URL=
CLERK_ISSUER=

# your Vercel domain(s), comma-separated; tauri origins are for the desktop app
CORS_ORIGINS=http://localhost:3000,tauri://localhost,http://tauri.localhost
CORS_ORIGIN_REGEX=

# mock (no key) | finnhub
MARKET_PROVIDER=mock
FINNHUB_API_KEY=
# optional: company descriptions, statements, price targets, dividends
FMP_API_KEY=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# model dispatcher (LiteLLM model ids); server keys are optional when users bring their own
DEFAULT_MODEL=anthropic/claude-sonnet-5-5
FAST_MODEL=anthropic/claude-haiku-4-5-20251001
FALLBACK_MODELS=openai/gpt-4o-mini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

WORKER_INTERVAL_SECONDS=300
