# Render API URL. Baked in at build time; users can override it in Settings.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase project (Firebase console → Project settings → Your apps → Web app). Set them when the
# API runs AUTH_MODE=firebase; leave them empty for local dev mode, where the API trusts the dev
# token from Settings. None of these is a secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google sign-in inside the desktop and Android apps (optional; without them those apps offer email
# and password only). Create the OAuth clients in the Google Cloud project behind Firebase; see the
# README. A desktop client's secret ships inside the app by design.
NEXT_PUBLIC_GOOGLE_DESKTOP_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_DESKTOP_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
