{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moatrics",
  "version": "0.1.0",
  "identifier": "app.moatrics.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix ../web run build:desktop",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "Moatrics",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' http://localhost:8000 https://*.onrender.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
