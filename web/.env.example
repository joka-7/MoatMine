# Render API URL. Baked in at build time; users can override it in Settings.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk publishable key (pk_test_… / pk_live_…). Set it when the API runs AUTH_MODE=clerk;
# leave it empty for local dev mode, where the API trusts the dev token from Settings.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
