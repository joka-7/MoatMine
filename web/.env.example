# Render API URL. Baked in at build time; users can override it in Settings.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase project (Firebase console → Project settings → Your apps → Web app). Set them when the
# API runs AUTH_MODE=firebase; leave them empty for local dev mode, where the API trusts the dev
# token from Settings. None of these is a secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
