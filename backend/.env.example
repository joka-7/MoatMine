# Render injects DATABASE_URL from the attached Postgres
DATABASE_URL=sqlite:///./moatmine.db
# Postgres pool per process (ignored for SQLite)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10

# dev = bearer token is the user id (local SQLite only; refuses to start on Postgres)
# clerk = verify Clerk JWTs (needs both values below)
AUTH_MODE=dev
CLERK_JWKS_URL=
CLERK_ISSUER=

# your Vercel domain(s), comma-separated; tauri origins are for the desktop app
CORS_ORIGINS=http://localhost:3000,tauri://localhost,http://tauri.localhost
CORS_ORIGIN_REGEX=

# mock (no key) | finnhub
MARKET_PROVIDER=mock
FINNHUB_API_KEY=
# optional: company descriptions, statements, price targets, dividends
FMP_API_KEY=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# AI goes through ModelDispatcher. Server keys are optional: users can add their own in Settings → AI.
# A vendor with a server key is available to every user (rate-limited per user below).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
AI_REQUESTS_PER_MIN=20
AI_TOKENS_PER_MIN=60000
AI_TOKENS_PER_DAY=1000000
AI_TIMEOUT_SECONDS=90

WORKER_INTERVAL_SECONDS=300

# per-user requests per minute on routes that spend provider / AI quota
RATE_LIMIT_MARKET_PER_MIN=240
RATE_LIMIT_AI_PER_MIN=30

# text locally; json in production (one JSON object per line, provider keys redacted)
LOG_LEVEL=INFO
LOG_FORMAT=text
